# Optional on the backend. Empty uses the local educational fallback.
# Set the real value securely in Render, never in GitHub Pages build variables.
GEMINI_API_KEY=

# Non-secret model identifier. The server defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional frontend override, read by Vite at build time.
# Leave unset for same-origin API in development and the default Render API in production.
# VITE_API_URL=https://orientia-web.onrender.com

# Render sets NODE_ENV=production and supplies PORT automatically.
# Local development uses npm run dev with NODE_ENV unset.
